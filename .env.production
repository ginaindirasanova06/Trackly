#--------------------------------------------------------------------
# TRACKLY Production Environment Configuration
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# Base URL (Capuang Cloud Lab Studio)
app.baseURL = 'https://lab-studio.cloud/Trackly/public/'
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'

#--------------------------------------------------------------------
# ACTIVE DATABASE CONFIGURATION (SQLite3 High Performance)
#--------------------------------------------------------------------
database.default.hostname = ''
database.default.database = '/home/capd4965/public_html/lab-studio.cloud/Trackly/writable/trackly.sqlite'
database.default.username = ''
database.default.password = ''
database.default.DBDriver = 'SQLite3'
database.default.DBPrefix = ''

