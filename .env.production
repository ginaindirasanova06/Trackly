# Encryption
encryption.key = hex2bin:f7e91a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f

# Session
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'trackly_session'
session.expiration = 7200
session.savePath = null
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

# Logger (Threshold 1 = Error only for production security)
logger.threshold = 1
